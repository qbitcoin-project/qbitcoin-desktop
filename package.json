{
  "name": "qbitcoin-wallet-desktop",
  "version": "1.7.0",
  "private": true,
  "description": "Desktop wallet for the post-quantum QBitcoin (QBT) network.",
  "license": "Apache-2.0",
  "author": "QBitcoin",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.34.7"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac:test": "electron-vite build && electron-builder --mac --config electron-builder.test.yml",
    "build:mac:beta": "node build/build-mac-beta.mjs --prepare-only",
    "dist:mac:beta": "node build/build-mac-beta.mjs --distribute",
    "changes:add": "node build/release.mjs add",
    "release:preview": "node build/release.mjs preview",
    "release:prepare": "node build/release.mjs prepare",
    "release:check": "node build/release.mjs check",
    "release:record": "node build/release.mjs record",
    "brand:check": "node build/brand.mjs check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@qbtc/chain": "1.2.0",
    "@qbtc/crypto": "1.1.0",
    "@qbtc/vault": "1.1.0",
    "electron-updater": "6.8.10",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@noble/hashes": "1.7.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
